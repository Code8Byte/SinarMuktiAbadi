{
  "name": "website-customer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:sma": "vite --mode sma --port 5173",
    "dev:st": "vite --mode st --port 5174",
    "build:sma": "vite build --mode sma",
    "build:st": "vite build --mode st",
    "preview:sma": "vite preview --outDir dist/sma",
    "preview:st": "vite preview --outDir dist/st",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-vue-next": "^0.453.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "happy-dom": "^15.7.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.8"
  }
}
